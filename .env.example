# Copy to .env.local. Every key is optional locally; production builds refuse to ship without the required ones
# (see README → Environment variables and scripts/check-launch-env.mjs).

# Required in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
CRON_SECRET=
IP_HASH_SALT=
CAL_WEBHOOK_SECRET=

# Lead alerts: CONTACT_TO_EMAIL is the destination (defaults to info@axisandsage.com).
# FOUNDER_EMAILS is optional, comma-separated: copies of each alert. Duplicates and CONTACT_TO_EMAIL are ignored.
CONTACT_TO_EMAIL=info@axisandsage.com
FOUNDER_EMAILS=

# Optional: default shown
# MAIL_FROM=Axis & Sage <info@axisandsage.com>

# Optional: the build warns while these are missing
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Off at launch: GA4 with Consent Mode
NEXT_PUBLIC_GA_ID=

# Content is in Sanity (project dltrl1ld, dataset production; fixed in src/sanity/env.ts). The site needs no token.
# Development only: run the site's queries against the local seed. Refused when VERCEL_ENV=production.
# SANITY_CONTENT_SOURCE=seed
# Seeder only (pnpm sanity:seed --apply / --publish), on a trusted machine. Never set in Vercel, never commit.
# SANITY_API_WRITE_TOKEN=
