# Copy to .env.local. Every key is optional locally; production builds refuse to ship without the required ones
# (see README → Environment variables and scripts/check-launch-env.mjs).

# Required in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
FOUNDER_EMAILS=
CRON_SECRET=
IP_HASH_SALT=
NEXT_PUBLIC_BOOKING_URL=https://cal.com/axisandsage/30min
CAL_WEBHOOK_SECRET=

# Optional: defaults shown
# MAIL_FROM=Axis & Sage <info@axisandsage.com>
# CONTACT_TO_EMAIL=info@axisandsage.com

# Optional: the build warns while these are missing
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_LINKEDIN_IFEANYI=
NEXT_PUBLIC_LINKEDIN_TOMIWA=
NEXT_PUBLIC_PORTFOLIO_TOMIWA=

# Off at launch: GA4 with Consent Mode
NEXT_PUBLIC_GA_ID=
