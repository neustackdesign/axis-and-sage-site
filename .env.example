# Copy to .env.local. Every key is optional locally; production builds refuse to ship without the launch-critical ones
# (see README → Environment variables and scripts/check-launch-env.mjs).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead pipeline
DATABASE_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
RESEND_API_KEY=
FOUNDER_EMAILS=
CONTACT_TO_EMAIL=info@axisandsage.com
MAIL_FROM=Axis & Sage <hello@notify.axisandsage.com>
MAIL_REPLY_TO=info@axisandsage.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SIGNING_SECRET=

# CRM, newsletter, booking
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW_LEAD=
HUBSPOT_STAGE_CALL_BOOKED=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
NEXT_PUBLIC_BOOKING_URL=
CAL_WEBHOOK_SECRET=

# Optional presentation settings. Elements stay hidden until these are set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
